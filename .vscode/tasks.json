
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build MEDICODE",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-g",
                "main.cpp",
                "mainmenu.cpp",
                "patientprofile.cpp",
                "updatepatientinfo.cpp",
                "healthcare.cpp",
                "medicodebanner.cpp",
                "patientconsent.cpp",
                "patientpersonalinfo.cpp",
                "generalquestions.cpp",
                "healthcarefacility.cpp",
                "exitprogram.cpp",
                "pdfgenerator.cpp",
                "PDFgen/pdfgen.c",
                "-o",
                "main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true  
            }
        }
    ]
}
